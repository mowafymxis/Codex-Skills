{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/competitor-feature-intelligence-1.0.0.json",
  "title": "Competitor Feature Intelligence Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "pluginVersion",
    "app",
    "competitors",
    "appFeatures",
    "competitorFeatures",
    "normalizedFeatures",
    "featureGaps",
    "uxAnalysis",
    "pricingAnalysis",
    "trustSecurityAnalysis",
    "growthRetentionAnalysis",
    "seoAnalysis",
    "accessibilityAnalysis",
    "technicalFeasibility",
    "roadmap",
    "doNotBuildYet",
    "positioning",
    "changes",
    "sources",
    "uncertainty",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pluginVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "app": { "$ref": "#/$defs/app" },
    "competitors": { "type": "array", "items": { "$ref": "#/$defs/competitor" } },
    "appFeatures": { "type": "array", "items": { "$ref": "#/$defs/appFeature" } },
    "competitorFeatures": { "type": "array", "items": { "$ref": "#/$defs/competitorFeature" } },
    "normalizedFeatures": { "type": "array", "items": { "type": "object" } },
    "featureGaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "uxAnalysis": { "type": "object" },
    "pricingAnalysis": { "type": "object" },
    "trustSecurityAnalysis": { "type": "object" },
    "growthRetentionAnalysis": { "type": "object" },
    "seoAnalysis": { "type": "object" },
    "accessibilityAnalysis": { "type": "object" },
    "technicalFeasibility": { "type": "array", "items": { "type": "object" } },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildNow",
        "buildNext",
        "validateFirst",
        "consider",
        "later",
        "monitor",
        "ignore"
      ],
      "properties": {
        "buildNow": { "$ref": "#/$defs/gapArray" },
        "buildNext": { "$ref": "#/$defs/gapArray" },
        "validateFirst": { "$ref": "#/$defs/gapArray" },
        "consider": { "$ref": "#/$defs/gapArray" },
        "later": { "$ref": "#/$defs/gapArray" },
        "monitor": { "$ref": "#/$defs/gapArray" },
        "ignore": { "$ref": "#/$defs/gapArray" }
      }
    },
    "doNotBuildYet": { "$ref": "#/$defs/gapArray" },
    "positioning": { "type": "object" },
    "changes": { "type": "array", "items": { "type": "object" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "uncertainty": { "$ref": "#/$defs/stringArray" },
    "warnings": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["type", "summary"],
      "properties": {
        "type": { "enum": ["code", "documentation", "source"] },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" },
        "summary": { "type": "string" },
        "reliability": { "enum": ["high", "medium", "low", "unknown"] }
      }
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "url",
        "category",
        "targetUsers",
        "businessModel",
        "stage",
        "summary",
        "maturity",
        "techStack",
        "strengths",
        "weaknesses",
        "evidence"
      ],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string" },
        "targetUsers": { "$ref": "#/$defs/stringArray" },
        "businessModel": { "type": "string" },
        "stage": { "type": "string" },
        "summary": { "type": "string" },
        "maturity": { "type": "string" },
        "techStack": { "$ref": "#/$defs/stringArray" },
        "strengths": { "$ref": "#/$defs/stringArray" },
        "weaknesses": { "$ref": "#/$defs/stringArray" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "type": { "enum": ["direct", "indirect", "substitute", "open-source", "benchmark"] }
      }
    },
    "appFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "description",
        "userValue",
        "status",
        "maturityScore",
        "confidence",
        "evidence",
        "relatedFiles",
        "dependencies",
        "qualityNotes",
        "risks",
        "missingPieces"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "userValue": { "type": "string" },
        "status": {
          "enum": [
            "not-implemented",
            "mentioned-only",
            "prototype",
            "partial",
            "functional",
            "polished",
            "deprecated",
            "unknown"
          ]
        },
        "maturityScore": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "relatedFiles": { "$ref": "#/$defs/stringArray" },
        "dependencies": { "$ref": "#/$defs/stringArray" },
        "qualityNotes": { "$ref": "#/$defs/stringArray" },
        "risks": { "$ref": "#/$defs/stringArray" },
        "missingPieces": { "$ref": "#/$defs/stringArray" }
      }
    },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "competitorFeature": {
      "type": "object",
      "required": [
        "id",
        "competitorId",
        "name",
        "normalizedName",
        "category",
        "description",
        "userWorkflow",
        "targetUser",
        "availability",
        "evidenceType",
        "confidence",
        "maturityEstimate",
        "uxEstimate",
        "strategicValue",
        "tableStakes",
        "differentiating",
        "sources",
        "notes"
      ],
      "properties": {
        "id": { "type": "string" },
        "competitorId": { "type": "string" },
        "name": { "type": "string" },
        "normalizedName": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "userWorkflow": { "type": "string" },
        "targetUser": { "type": "string" },
        "availability": {
          "type": "object",
          "required": ["plan", "platform", "region", "status"],
          "properties": {
            "plan": { "type": "string" },
            "platform": { "type": "string" },
            "region": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "evidenceType": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "maturityEstimate": { "type": "string" },
        "uxEstimate": { "type": "string" },
        "strategicValue": { "type": "string" },
        "tableStakes": { "type": "boolean" },
        "differentiating": { "type": "boolean" },
        "sources": { "$ref": "#/$defs/stringArray" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "scoreInputs": {
      "type": "object",
      "required": [
        "importance",
        "urgency",
        "userPainSeverity",
        "revenueImpact",
        "retentionImpact",
        "activationImpact",
        "trustImpact",
        "uniqueness",
        "strategicFit",
        "evidenceStrength",
        "difficulty",
        "operationalCost",
        "mvpSuitability"
      ],
      "properties": {
        "importance": { "$ref": "#/$defs/score" },
        "urgency": { "$ref": "#/$defs/score" },
        "userPainSeverity": { "$ref": "#/$defs/score" },
        "revenueImpact": { "$ref": "#/$defs/score" },
        "retentionImpact": { "$ref": "#/$defs/score" },
        "activationImpact": { "$ref": "#/$defs/score" },
        "trustImpact": { "$ref": "#/$defs/score" },
        "uniqueness": { "$ref": "#/$defs/score" },
        "strategicFit": { "$ref": "#/$defs/score" },
        "evidenceStrength": { "$ref": "#/$defs/score" },
        "difficulty": { "$ref": "#/$defs/score" },
        "operationalCost": { "$ref": "#/$defs/score" },
        "mvpSuitability": { "$ref": "#/$defs/score" },
        "securityBlocker": { "type": "boolean" },
        "damagesSimplicity": { "type": "boolean" }
      }
    },
    "score": { "type": "number", "minimum": 1, "maximum": 5 },
    "gap": {
      "type": "object",
      "required": [
        "id",
        "feature",
        "category",
        "appStatus",
        "competitiveStatus",
        "competitors",
        "recommendation",
        "priorityLabel",
        "priorityScore",
        "scoreInputs",
        "rationale",
        "evidence",
        "confidence",
        "mvpVersion",
        "fullVersion",
        "risks"
      ],
      "properties": {
        "id": { "type": "string" },
        "feature": { "type": "string" },
        "category": { "type": "string" },
        "appStatus": { "type": "string" },
        "competitiveStatus": { "type": "string" },
        "competitors": { "$ref": "#/$defs/stringArray" },
        "recommendation": { "type": "string" },
        "priorityLabel": { "type": "string" },
        "priorityScore": { "type": "number", "minimum": 0, "maximum": 5 },
        "scoreInputs": { "$ref": "#/$defs/scoreInputs" },
        "rationale": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "mvpVersion": { "type": "string" },
        "fullVersion": { "type": "string" },
        "risks": { "$ref": "#/$defs/stringArray" }
      }
    },
    "gapArray": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "source": {
      "type": "object",
      "required": [
        "competitorId",
        "url",
        "canonicalUrl",
        "sourceType",
        "title",
        "publisher",
        "isOfficial",
        "publishedAt",
        "retrievedAt",
        "contentHash",
        "fetchStatus",
        "httpStatus",
        "text",
        "relevantSnippets",
        "reliability",
        "notes"
      ],
      "properties": {
        "competitorId": { "type": "string" },
        "url": { "type": "string" },
        "canonicalUrl": { "type": "string" },
        "sourceType": { "type": "string" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "isOfficial": { "type": "boolean" },
        "publishedAt": { "type": ["string", "null"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "type": "string" },
        "fetchStatus": { "enum": ["success", "failed", "blocked", "cached", "manual"] },
        "httpStatus": { "type": ["integer", "null"] },
        "text": { "type": "string" },
        "relevantSnippets": { "$ref": "#/$defs/stringArray" },
        "reliability": { "enum": ["high", "medium", "low", "unknown"] },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
